# ===== TaskMesh environment template =====
# Copy to .env and adjust. NEVER commit a populated .env.
# All variables use the TASKMESH_ prefix.

# PostgreSQL connection (SQLAlchemy URL). Use a strong password outside dev.
TASKMESH_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/taskmesh

# Redis connection (used for worker heartbeats only).
TASKMESH_REDIS_URL=redis://localhost:6379/0

# Worker
TASKMESH_WORKER_CONCURRENCY=4
TASKMESH_LEASE_SECONDS=120
TASKMESH_MAX_ATTEMPTS=5
TASKMESH_RETRY_BACKOFF_BASE_SECONDS=2.0
TASKMESH_RETRY_BACKOFF_MAX_SECONDS=300.0

# API
# Leave TASKMESH_API_TOKEN empty in dev to disable auth on operational endpoints.
# Set it (e.g. openssl rand -hex 32) to require Bearer auth on cancel/retry.
TASKMESH_API_TOKEN=
# Comma-separated list; keep as narrow as your deployment allows.
TASKMESH_CORS_ORIGINS=http://localhost:8080
TASKMESH_MAX_PAYLOAD_CHARS=10000
